{
  "schema_version": "pkoc-provider-v1",
  "backend": "openai-compatible",
  "model": "REPLACE_WITH_ADVERTISED_MODEL",
  "endpoint": "https://api.example.invalid/v1",
  "api_key_env": "PKOC_API_KEY",
  "capabilities": {
    "json_schema": true,
    "seed": false,
    "thinking": false,
    "tokenization": "declared-upper-bound",
    "tokens_per_utf8_byte_upper_bound": 1,
    "chat_overhead_tokens": 1024
