  "stages": {
    "extraction": {
      "input_ceiling": 5888,
      "max_tokens": 1024,
      "context_size": 8192,
      "token_margin": 256,
      "temperature": 0
    },
    "resolution": {
      "input_ceiling": 6000,
      "max_tokens": 4096,
      "context_size": 12288,
      "token_margin": 256,
      "temperature": 0
    },
    "offices": {
      "input_ceiling": 6000,
      "max_tokens": 4096,
      "context_size": 12288,
      "token_margin": 256,
      "temperature": 0
    },
    "cameo": {
      "input_ceiling": 6000,
      "max_tokens": 4096,
      "context_size": 12288,
      "token_margin": 256,
      "temperature": 0
    }
  },
  "max_attempts": 2,
  "timeout_seconds": 1800,
  "models_path": "/models",
  "chat_path": "/chat/completions",
  "capability_note": "Example only. Verify every declared capability, tokenizer bound and chat overhead for the selected provider before execution."
}
